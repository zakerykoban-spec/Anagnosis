 .office-card,
 .reader-shell {
   background:
-    var(--parchment-image) center top / 100% auto repeat-y,
+    var(--parchment-center-image) center top / 100% auto repeat-y,
     var(--paper);
 }
 
+/*
+ * A manuscript surface has one top edge, a repeatable middle, and one bottom
+ * edge. The soft masks blend the cap artwork into the center texture without
+ * stretching either source image or exposing a false second page.
+ */
+.office-card::before,
+.office-card::after,
+.reader-shell::before,
+.reader-shell::after {
+  position: absolute;
+  z-index: -1;
+  right: 0;
+  left: 0;
+  height: var(--manuscript-cap-height);
+  pointer-events: none;
+  background-image: var(--parchment-folio-image);
+  background-repeat: no-repeat;
+  background-size: 100% auto;
+  content: '';
+}
+
+.office-card::before,
+.reader-shell::before {
+  top: 0;
+  background-position: center top;
+  -webkit-mask-image: linear-gradient(to bottom, #000 0 68%, transparent 100%);
+  mask-image: linear-gradient(to bottom, #000 0 68%, transparent 100%);
+}
+
+.office-card::after,
+.reader-shell::after {
+  bottom: 0;
+  background-position: center bottom;
+  -webkit-mask-image: linear-gradient(to top, #000 0 68%, transparent 100%);
+  mask-image: linear-gradient(to top, #000 0 68%, transparent 100%);
+}
+
+.office-card {
+  min-height: calc(
+    100dvh - max(26px, env(safe-area-inset-top)) -
+      max(30px, env(safe-area-inset-bottom))
+  );
+  padding-top: clamp(30px, 4.2vw, 49px);
+  padding-bottom: clamp(46px, 5.5vw, 64px);
+  border: 0;
+  border-radius: 0;
+  box-shadow:
+    0 30px 76px var(--shadow),
+    inset 0 0 32px rgba(98, 62, 27, 0.08);
+}
+
+.reader-shell {
+  border-inline: 0;
+  box-shadow: 0 0 70px var(--shadow);
+}
+
+.reader-header,
+.reader-navigation {
+  background: var(--paper);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+}
+
+.scripture,
+.prayer-reader {
+  position: relative;
+  z-index: 1;
+}
+
+.verse,
+.long-form-verse {
+  scroll-margin-block-start: 92px;
+  scroll-margin-block-end: calc(var(--reader-navigation-height) + 24px);
+}
+
+.completion-actions {
+  position: relative;
+  z-index: 1;
+}
+
+.reader-navigation {
+  min-height: var(--reader-navigation-height);
+}
+
 .canonical-icon,
 .manuscript-art,
 .navigation-art,

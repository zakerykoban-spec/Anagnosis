{
  "name": "anagnosis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "scripture:import": "node scripts/import-sblgnt.mjs && node scripts/import-lxx.mjs",
    "scripture:import:lxx": "node scripts/import-lxx.mjs",
    "scripture:validate": "node scripts/validate-sblgnt.mjs && node scripts/validate-lxx.mjs",
    "scripture:validate:lxx": "node scripts/validate-lxx.mjs",
    "scripture:import:step": "node scripts/import-step-tagnt.mjs",
    "scripture:validate:step": "node scripts/validate-step-tagnt.mjs",
    "scripture:import:syntax": "node scripts/import-macula-syntax.mjs",
    "scripture:validate:syntax": "node scripts/validate-macula-syntax.mjs",
    "scripture:import:lxx-assistance": "node scripts/import-lxx-assistance.mjs",
    "scripture:validate:lxx-assistance": "node scripts/validate-lxx-assistance.mjs",
